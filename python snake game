import pygame
import random

pygame.init()

# -----------------------------
# Screen
# -----------------------------
WIDTH = 600
HEIGHT = 450
BLOCK = 20

screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Snake Game")

# -----------------------------
# Colors
# -----------------------------
BLACK = (0, 0, 0)
GREEN = (0, 200, 0)
DARK_GREEN = (0, 140, 0)
RED = (255, 60, 60)
WHITE = (255, 255, 255)
GRAY = (100, 100, 100)
BLUE = (50, 150, 255)
DARK_BLUE = (30, 100, 180)

# -----------------------------
# Fonts
# -----------------------------
score_font = pygame.font.Font(None, 32)
game_over_font = pygame.font.Font(None, 60)
button_font = pygame.font.Font(None, 30)

# -----------------------------
# Clock
# -----------------------------
clock = pygame.time.Clock()

# -----------------------------
# Create apple
# -----------------------------
def create_apple(snake):
    while True:
        apple = (
            random.randrange(0, WIDTH, BLOCK),
            random.randrange(60, HEIGHT, BLOCK)
        )

        if apple not in snake:
            return apple


# -----------------------------
# Reset game
# -----------------------------
def reset_game():
    snake = [
        (100, 100),
        (80, 100),
        (60, 100)
    ]

    direction = "RIGHT"
    next_direction = "RIGHT"

    apple = create_apple(snake)
    score = 0
    game_over = False

    return snake, direction, next_direction, apple, score, game_over


# -----------------------------
# Start
# -----------------------------
snake, direction, next_direction, apple, score, game_over = reset_game()

running = True

# Play Again button
play_again_button = pygame.Rect(
    WIDTH // 2 - 110,
    HEIGHT // 2 + 50,
    220,
    55
)

# -----------------------------
# Main loop
# -----------------------------
while running:

    # -------------------------
    # Events
    # -------------------------
    for event in pygame.event.get():

        if event.type == pygame.QUIT:
            running = False

        # Keyboard controls
        if event.type == pygame.KEYDOWN:

            if not game_over:

                if event.key == pygame.K_UP and direction != "DOWN":
                    next_direction = "UP"

                elif event.key == pygame.K_DOWN and direction != "UP":
                    next_direction = "DOWN"

                elif event.key == pygame.K_LEFT and direction != "RIGHT":
                    next_direction = "LEFT"

                elif event.key == pygame.K_RIGHT and direction != "LEFT":
                    next_direction = "RIGHT"

            else:

                # Press R to restart
                if event.key == pygame.K_r:
                    snake, direction, next_direction, apple, score, game_over = reset_game()

                # ESC to quit
                elif event.key == pygame.K_ESCAPE:
                    running = False

        # -------------------------
        # Mouse click Play Again
        # -------------------------
        if event.type == pygame.MOUSEBUTTONDOWN:

            if game_over and play_again_button.collidepoint(event.pos):

                snake, direction, next_direction, apple, score, game_over = reset_game()

    # -------------------------
    # Game logic
    # -------------------------
    if not game_over:

        # Update direction
        direction = next_direction

        # Current head
        head_x, head_y = snake[0]

        # Move
        if direction == "UP":
            head_y -= BLOCK

        elif direction == "DOWN":
            head_y += BLOCK

        elif direction == "LEFT":
            head_x -= BLOCK

        elif direction == "RIGHT":
            head_x += BLOCK

        new_head = (head_x, head_y)

        # -------------------------
        # Wall collision
        # -------------------------
        if (
            head_x < 0
            or head_x >= WIDTH
            or head_y < 60
            or head_y >= HEIGHT
        ):
            game_over = True

        # -------------------------
        # Snake collision
        # -------------------------
        elif new_head in snake:
            game_over = True

        else:

            # Add head
            snake.insert(0, new_head)

            # ---------------------
            # Apple eaten
            # ---------------------
            if new_head == apple:

                score += 1

                # New apple
                apple = create_apple(snake)

                # Don't remove tail
                # This makes snake grow

            else:

                # Remove tail
                snake.pop()

    # -----------------------------
    # Draw background
    # -----------------------------
    screen.fill(BLACK)

    # -----------------------------
    # Score
    # -----------------------------
    score_text = score_font.render(
        "Score: " + str(score),
        True,
        WHITE
    )

    screen.blit(score_text, (10, 15))

    # -----------------------------
    # Divider
    # -----------------------------
    pygame.draw.line(
        screen,
        GRAY,
        (0, 55),
        (WIDTH, 55),
        2
    )

    # -----------------------------
    # Apple
    # -----------------------------
    pygame.draw.rect(
        screen,
        RED,
        (
            apple[0],
            apple[1],
            BLOCK,
            BLOCK
        )
    )

    # -----------------------------
    # Snake
    # -----------------------------
    for i, block in enumerate(snake):

        if i == 0:
            color = DARK_GREEN
        else:
            color = GREEN

        pygame.draw.rect(
            screen,
            color,
            (
                block[0],
                block[1],
                BLOCK,
                BLOCK
            )
        )

        pygame.draw.rect(
            screen,
            BLACK,
            (
                block[0],
                block[1],
                BLOCK,
                BLOCK
            ),
            1
        )

    # -----------------------------
    # GAME OVER
    # -----------------------------
    if game_over:

        # Overlay
        overlay = pygame.Surface((WIDTH, HEIGHT))
        overlay.set_alpha(190)
        overlay.fill(BLACK)
        screen.blit(overlay, (0, 0))

        # Game Over
        game_over_text = game_over_font.render(
            "GAME OVER",
            True,
            RED
        )

        game_over_rect = game_over_text.get_rect(
            center=(WIDTH // 2, HEIGHT // 2 - 50)
        )

        screen.blit(
            game_over_text,
            game_over_rect
        )

        # Score
        final_score = score_font.render(
            "Final Score: " + str(score),
            True,
            WHITE
        )

        final_score_rect = final_score.get_rect(
            center=(WIDTH // 2, HEIGHT // 2 + 5)
        )

        screen.blit(
            final_score,
            final_score_rect
        )

        # -------------------------
        # Play Again button
        # -------------------------

        mouse_pos = pygame.mouse.get_pos()

        if play_again_button.collidepoint(mouse_pos):
            button_color = DARK_BLUE
        else:
            button_color = BLUE

        pygame.draw.rect(
            screen,
            button_color,
            play_again_button
        )

        play_again_text = button_font.render(
            "PLAY AGAIN",
            True,
            WHITE
        )

        play_again_rect = play_again_text.get_rect(
            center=play_again_button.center
        )

        screen.blit(
            play_again_text,
            play_again_rect
        )

        # Instruction
        instruction = score_font.render(
            "Click the button to restart",
            True,
            WHITE
        )

        instruction_rect = instruction.get_rect(
            center=(WIDTH // 2, HEIGHT // 2 + 130)
        )

        screen.blit(
            instruction,
            instruction_rect
        )

    # -----------------------------
    # Update screen
    # -----------------------------
    pygame.display.update()

    # -----------------------------
    # SPEED
    # -----------------------------
    # Lower number = slower snake
    clock.tick(7)


pygame.quit()
